# Copy this file to backend/.env and supply local values. Never commit backend/.env.

# Required PostgreSQL/PostGIS SQLAlchemy URL. Keep the example blank to avoid
# shipping a username, password, host, or other connection credential.
DATABASE_URL=

# Non-secret application settings.
RECOMMENDATION_MODEL_NAME=T10e2_CausalMemoryFusion
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=30

