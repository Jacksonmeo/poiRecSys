# Copy this file to backend/.env and supply local values. Never commit backend/.env.

# Required PostgreSQL/PostGIS SQLAlchemy URL. Keep the example blank to avoid
# shipping a username, password, host, or other connection credential.
DATABASE_URL=

# Non-secret application settings.
RECOMMENDATION_MODEL_NAME=T10e2_CausalMemoryFusion
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=30

# Agent context: use memory only for local tests; production uses Postgres + Redis.
AGENT_CONTEXT_BACKEND=postgres_redis
AGENT_CONTEXT_MAX_TOKENS=6000
AGENT_CONTEXT_POSTGRES_POOL_SIZE=5
REDIS_URL=redis://localhost:6379/0
AGENT_CONTEXT_CACHE_TTL_SECONDS=1800
AGENT_THREAD_LOCK_TIMEOUT_SECONDS=120
AGENT_THREAD_LOCK_WAIT_SECONDS=5

# Restrict checkpoint deserialization to the modules allowlisted in runtime.py.
LANGGRAPH_STRICT_MSGPACK=true
